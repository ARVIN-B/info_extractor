DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DATABASE_PATH=db.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
SOURCE_TIMEOUT_SECONDS=45
SOURCE_LOCK_WAIT_SECONDS=60
ENABLED_MCP_SOURCES=neshan,balad
MCP_DISTRIBUTED_SOURCE_LIMITS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
# Optional Iranian egress proxy if a source requires it.
NESHAN_MCP_PROXY=
BALAD_MCP_PROXY=
